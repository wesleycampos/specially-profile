Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # repassa o cabeçalho Authorization ao PHP (conector integracao.php)
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^api/(.*)$ api.php?r=$1 [QSA,L]
</IfModule>

# Nada de acesso direto a código interno, banco, configuração ou ao HTML sem login
<FilesMatch "^(config\.local\.php|adm\.php|router\.php|index\.html|.*\.sqlite|.*\.db|.*\.sql)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^.*/lib/.*$
